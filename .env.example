# Optional Docker Compose configuration. No secrets are needed to play.
# Copy to .env only when changing defaults. Node does not load this file automatically.
ALLOWED_ORIGINS=https://games.samuelciocan.com,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# Exact TCP address of your trusted Cloudflared container, never the whole subnet.
TRUSTED_CLOUDFLARE_IPS=
DISCONNECT_GRACE_PERIOD_MS=300000
BOT_THINKING_TIME_MS=650
MAX_ROOMS=500
MAX_CONNECTIONS=2000
ROOM_CREATE_LIMIT_PER_IP=10
ROOM_CREATE_LIMIT_GLOBAL=30
ROOM_CREATE_WINDOW_MS=60000
