{
  "name": "games-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Multiplayer Gaming Platform for games.samuelciocan.com",
  "scripts": {
    "dev": "pnpm --parallel --recursive run dev",
    "dev:server": "pnpm --filter games-server dev",
    "dev:client": "pnpm --filter games-client dev",
    "build": "pnpm --filter @games/game-logic build && pnpm --filter games-server build && pnpm --filter games-client build",
    "test": "pnpm --filter @games/game-logic test",
    "start": "pnpm --filter games-server start"
  },
  "packageManager": "pnpm@12.10.1",
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
